<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.Models"
    x:DataType="viewmodels:ScheduleViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HorizontalStackLayout Grid.Row="0"
                               Padding="16,8"
                               Spacing="8">
            <Label Text="Month:"
                   VerticalOptions="Center" />

            <Picker ItemsSource="{Binding MonthFilters}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedMonthFilter}"
                    HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ScheduledItems}"
                        Margin="16"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="No scheduled items yet."
                           FontAttributes="Bold" />
                    <Label Text="Tap + to schedule an upcoming payment."
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ScheduledTransaction">

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DangerSwipeItem}"
                                           Invoked="OnDeleteSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 12"
                                Padding="12"
                                Margin="0,4">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Note}"
                                       FontAttributes="Bold" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding ScheduledDate, StringFormat='{0:yyyy-MM-dd}'}"
                                       FontSize="12"
                                       Style="{StaticResource MutedLabel}" />

                                <Label Grid.RowSpan="2"
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding Amount, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold" />
                            </Grid>

                        </Border>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Text="+"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="24"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="24"
                Grid.RowSpan="2"
                Clicked="OnAddClicked" />

    </Grid>

</ContentPage>
