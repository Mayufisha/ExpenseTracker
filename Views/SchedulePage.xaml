<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.Models"
    x:DataType="viewmodels:ScheduleViewModel">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Schedule" FontSize="28" FontAttributes="Bold" />
                <Label Text="Manage upcoming income and payments in one workspace."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Add scheduled item" Clicked="OnAddClicked" />
        </Grid>

        <Border x:Name="ScheduleEditor" Grid.Row="1" Padding="16" IsVisible="False">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="ScheduleEditorTitle"
                       Text="Add scheduled item"
                       FontSize="20"
                       FontAttributes="Bold" />
                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="End">
                    <VerticalStackLayout WidthRequest="260" Margin="0,0,12,8" Spacing="4">
                        <Label Text="Description" Style="{StaticResource MutedLabel}" />
                        <Entry x:Name="ScheduleNoteEntry" Placeholder="Rent, payday, subscription" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="160" Margin="0,0,12,8" Spacing="4">
                        <Label Text="Amount" Style="{StaticResource MutedLabel}" />
                        <Entry x:Name="ScheduleAmountEntry" Keyboard="Numeric" Placeholder="0.00" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="180" Margin="0,0,12,8" Spacing="4">
                        <Label Text="Date" Style="{StaticResource MutedLabel}" />
                        <DatePicker x:Name="ScheduleDatePicker" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="150" Margin="0,0,12,8" Spacing="4">
                        <Label Text="Type" Style="{StaticResource MutedLabel}" />
                        <Picker x:Name="ScheduleTypePicker">
                            <Picker.Items>
                                <x:String>Expense</x:String>
                                <x:String>Income</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="160" Margin="0,0,12,8" Spacing="4">
                        <Label Text="Frequency" Style="{StaticResource MutedLabel}" />
                        <Picker x:Name="ScheduleFrequencyPicker">
                            <Picker.Items>
                                <x:String>None</x:String>
                                <x:String>Weekly</x:String>
                                <x:String>Monthly</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </FlexLayout>
                <Label x:Name="ScheduleEditorError" TextColor="{StaticResource Danger}" IsVisible="False" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Save scheduled item" Clicked="OnSaveScheduleClicked" />
                    <Button Text="Cancel" Style="{StaticResource TextButton}" Clicked="OnCancelScheduleClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label x:Name="ScheduleStatusLabel" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
            <Picker Grid.Column="1"
                    WidthRequest="210"
                    ItemsSource="{Binding MonthFilters}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedMonthFilter}" />
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding ScheduledItems}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="No scheduled items for this user yet." FontAttributes="Bold" />
                    <Label Text="Select Add scheduled item to create one." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ScheduledTransaction">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DangerSwipeItem}"
                                           Invoked="OnDeleteSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border StrokeShape="RoundRectangle 12" Padding="12" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Note}" FontAttributes="Bold" />
                                <HorizontalStackLayout Grid.Row="1" Spacing="12">
                                    <Label Text="{Binding ScheduledDate, StringFormat='{0:MMM d, yyyy}'}"
                                           Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding Frequency}" Style="{StaticResource MutedLabel}" />
                                </HorizontalStackLayout>
                                <Label Grid.RowSpan="2"
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding Amount, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
