<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Welcome">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="ExpenseTracker"
                   FontSize="34"
                   FontAttributes="Bold" />
            <Label Text="Sign in securely to access and sync your financial data."
                   Style="{StaticResource MutedLabel}" />

            <Border Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Supabase connection" FontAttributes="Bold" />
                    <Entry x:Name="ProjectUrlEntry"
                           Placeholder="https://your-project.supabase.co"
                           Keyboard="Url" />
                    <Entry x:Name="PublishableKeyEntry"
                           Placeholder="Publishable or anon key" />
                    <Label Text="These values identify the app's Supabase project. They can be embedded at build time."
                           FontSize="12"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   Keyboard="Email" />
            <Entry x:Name="PasswordEntry"
                   Placeholder="Password"
                   IsPassword="True" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Sign Up"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnSignUpClicked" />
                <Button Text="Login"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnLoginClicked" />
            </HorizontalStackLayout>

            <Label Text="An account is required. If email confirmation is enabled, confirm your email before logging in."
                   Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
