<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Welcome">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Money Manager"
                   FontSize="34"
                   FontAttributes="Bold" />
            <Label Text="Sign in to access your financial workspace."
                   Style="{StaticResource MutedLabel}" />

            <Border Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="BackendTitleLabel" Text="Account security" FontAttributes="Bold" />
                    <Label x:Name="BackendDescriptionLabel" Text="Checking the configured account service."
                           FontSize="12"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   Keyboard="Email" />
            <Entry x:Name="PasswordEntry"
                   Placeholder="Password"
                   MaxLength="128"
                   IsPassword="True" />
            <Label Text="Use 12-128 characters. Password managers and unique passphrases are recommended."
                   FontSize="12"
                   Style="{StaticResource MutedLabel}" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Sign Up"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnSignUpClicked" />
                <Button Text="Login"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnLoginClicked" />
            </HorizontalStackLayout>

            <Label Text="An account is required. Create one here, then the app will restore your saved session automatically."
                   Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
