<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chart="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.Models"
    x:DataType="viewmodels:DashboardViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Dashboard"
                   FontSize="32"
                   FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        BackgroundColor="#E8F7F0">
                    <VerticalStackLayout>
                        <Label Text="Income" FontAttributes="Bold" />
                        <Label Text="{Binding TotalIncome, StringFormat='${0:F2}'}"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        BackgroundColor="#FDECEC">
                    <VerticalStackLayout>
                        <Label Text="Expenses" FontAttributes="Bold" />
                        <Label Text="{Binding TotalExpense, StringFormat='${0:F2}'}"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        BackgroundColor="#EAF1FF">
                    <VerticalStackLayout>
                        <Label Text="Assets" FontAttributes="Bold" />
                        <Label Text="{Binding TotalAssets, StringFormat='${0:F2}'}"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        BackgroundColor="#FFF3E6">
                    <VerticalStackLayout>
                        <Label Text="Liabilities" FontAttributes="Bold" />
                        <Label Text="{Binding TotalLiabilities, StringFormat='${0:F2}'}"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12"
                        BackgroundColor="#F3F4F6">
                    <VerticalStackLayout>
                        <Label Text="Net Cashflow" FontAttributes="Bold" />
                        <Label Text="{Binding NetCashFlow, StringFormat='${0:F2}'}"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Frame Padding="12"
                   BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True">

                <VerticalStackLayout Spacing="8">
                    <Label Text="6-Month Net Cashflow Trend"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <chart:ChartView x:Name="NetFlowChart"
                                     HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12"
                   BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Financial Composition"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />
                    <chart:ChartView x:Name="CompositionChart"
                                     HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <Border StrokeShape="RoundRectangle 16"
                    Padding="12"
                    BackgroundColor="#ECFDF3">
                <VerticalStackLayout>
                    <Label Text="Net Worth" FontAttributes="Bold" />
                    <Label Text="{Binding NetWorth, StringFormat='${0:F2}'}"
                           FontSize="22"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>


            <Label Text="Recent Transactions"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,16,0,0" />

            <CollectionView ItemsSource="{Binding Transactions}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label Text="No transactions yet."
                               FontAttributes="Bold" />
                        <Label Text="Add your first record from the Transactions tab."
                               TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <Border StrokeShape="RoundRectangle 12"
                                Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Note}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Type}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Grid.RowSpan="2"
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding Amount, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
