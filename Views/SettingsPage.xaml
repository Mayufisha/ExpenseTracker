<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <Label Text="Settings"
                   FontAttributes="Bold"
                   FontSize="28" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Theme" FontAttributes="Bold" />
                <Picker x:Name="ThemePicker"
                        Title="Choose theme"
                        SelectedIndexChanged="OnThemeChanged">
                    <Picker.Items>
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Data"
                       FontAttributes="Bold" />
                <Button Text="Export Backup"
                        Clicked="OnExportBackupClicked" />
                <Button Text="Import Backup"
                        Clicked="OnImportBackupClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Account &amp; Cloud Sync"
                       FontAttributes="Bold" />
                <Label Text="Use the same account and server on each device to sync data."
                       Style="{StaticResource MutedLabel}" />
                <Entry x:Name="ServerUrlEntry"
                       Placeholder="Server URL (e.g. https://api.example.com)" />
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email" />
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       IsPassword="True" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Register"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnRegisterClicked" />
                    <Button Text="Sign In"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnSignInClicked" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Upload Sync"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnUploadSyncClicked" />
                    <Button Text="Download Sync"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnDownloadSyncClicked" />
                </HorizontalStackLayout>
                <Button Text="Sign Out"
                        Clicked="OnSignOutClicked" />
                <Label x:Name="AccountStatusLabel"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
