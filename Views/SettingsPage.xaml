<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <Label Text="Settings"
                   FontAttributes="Bold"
                   FontSize="28" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Theme" FontAttributes="Bold" />
                <Picker x:Name="ThemePicker"
                        Title="Choose theme"
                        SelectedIndexChanged="OnThemeChanged">
                    <Picker.Items>
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Data"
                       FontAttributes="Bold" />
                <Button Text="Export Backup"
                        Clicked="OnExportBackupClicked" />
                <Button Text="Import Backup"
                        Clicked="OnImportBackupClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Payments" FontAttributes="Bold" />
                <Label Text="The card flow is a Stripe test sandbox only. Live peer-to-peer charging needs an approved payment-network partner."
                       Style="{StaticResource MutedLabel}" />
                <Button Text="Set up card sandbox"
                        Clicked="OnSetupCardPaymentsClicked" />
                <Entry x:Name="ETransferRecipientEntry"
                       Placeholder="Your e-Transfer deposit email or mobile" />
                <Entry x:Name="OnlineBankingUrlEntry"
                       Placeholder="Online banking HTTPS URL (optional)"
                       Keyboard="Url" />
                <Button Text="Save payment preferences"
                        Style="{StaticResource TextButton}"
                        Clicked="OnSavePaymentPreferencesClicked" />
                <Label x:Name="PaymentStatusLabel" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Account &amp; Cloud Sync"
                       FontAttributes="Bold" />
                <Label Text="Use the same Supabase account on each device to sync data."
                       Style="{StaticResource MutedLabel}" />
                <Label x:Name="ProjectStatusLabel"
                       FontSize="12"
                       Style="{StaticResource MutedLabel}" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Upload Sync"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnUploadSyncClicked" />
                    <Button Text="Download Sync"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnDownloadSyncClicked" />
                </HorizontalStackLayout>
                <Button Text="Sign Out"
                        Clicked="OnSignOutClicked" />
                <Label x:Name="AccountStatusLabel"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
