<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.SplitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.Models"
    x:DataType="viewmodels:SplitsViewModel"
    Title="Splits">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Shared expenses" FontSize="28" FontAttributes="Bold" />
                <Label Text="Turn any expense into a clear payment plan."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="New split"
                    VerticalOptions="Center"
                    Clicked="OnNewSplitClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Padding="14" StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#153B36}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Still owed" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalOutstanding, StringFormat='${0:F2}'}"
                           FontSize="24" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Padding="14" StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#123247}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Collected" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalCollected, StringFormat='${0:F2}'}"
                           FontSize="24" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Splits}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="Nothing to settle yet" FontSize="20" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Split a restaurant bill, trip fare, rent payment, or any imported expense."
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExpenseSplit">
                    <Border Padding="15" Margin="0,0,0,10" StrokeShape="RoundRectangle 16">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalAmount, StringFormat='${0:F2}'}"
                                   FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding ParticipantSummary}"
                                   Style="{StaticResource MutedLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SplitMethod}"
                                   Style="{StaticResource MutedLabel}" />
                            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                         Progress="{Binding CollectionProgress}"
                                         HeightRequest="7" />
                            <Label Grid.Row="3" Grid.ColumnSpan="2"
                                   Text="{Binding StatusDisplay}"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
