<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.Models"
    x:DataType="viewmodels:TransactionsViewModel">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Padding="16,8"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <Picker Grid.Column="0"
                    Title="Month"
                    ItemsSource="{Binding MonthFilters}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedMonthFilter}" />
            <Picker Grid.Column="1"
                    Title="Institution"
                    ItemsSource="{Binding InstitutionFilters}"
                    SelectedItem="{Binding SelectedInstitution}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transactions}"
                        Margin="16"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="No transactions found."
                           FontAttributes="Bold" />
                    <Label Text="Add a transaction or import a statement from Accounts."
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DangerSwipeItem}"
                                           Invoked="OnDeleteSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 12"
                                Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Note}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                       Style="{StaticResource MutedLabel}" />
                                <Label Grid.Row="2"
                                       Grid.Column="0"
                                       Text="{Binding SourceDisplay}"
                                       Style="{StaticResource MutedLabel}" />
                                <Label Grid.RowSpan="3"
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding Amount, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="+"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="24"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="24"
                Grid.RowSpan="2"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
